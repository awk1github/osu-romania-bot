# ==========================
# Python
# ==========================
__pycache__/
*.py[cod]
*$py.class

# ==========================
# Virtual environments
# ==========================
.venv/
venv/
env/
ENV/

# ==========================
# Environment variables
# ==========================
.env
.env.*

# ==========================
# SQLite databases
# ==========================
*.db
*.sqlite
*.sqlite3

# Keep the database folder structure
!database/
database/*.db
database/*.sqlite
database/*.sqlite3

